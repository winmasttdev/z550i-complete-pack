WAIT_FOR_POWER_SAVE_ENTER=05 01 00 03 03 $f $r4 4 4 4 5 
$c5 ED $cl $d0010  05 01 00 03 03 $f $r4 4 4 4 5 
$c5 ED $cl $d0010  05 01 00 03 03 $f $r4 4 4 4 5 

NIM_FPS= #SET(08,1E) #CMD(03,1E) #CMD(34,81) #W_F_M_T;

GET_CID= $m 1 f $b1 00 1 7;

LedEM= $p1 07 $c1 01 
               #SEQ(23,$r2 1 1)
               $m0 1 $/0 28 $c0 00
               $m0 1 $/0 03 $c0 00
               $cl
               #LED_SPEED $-0 03 $-0 r1 
               #CMD(04,$w0) 
               $cx $cx
               $cl
               #SEQ(23,$r2 1 1)
               $m0 1 $/0 28 $c0 00
               $m0 1 $/0 03 $c0 00
               $cl
               #LED_SPEED $-0 r1 
               #CMD(04,$w0) 
               $cx $cx $cx $cx;

EM= $p1 0d $c1 00
         $p1 0e $c1 00 
         #SEQ(23,$r2 1 1)
         $m0 1 $/0 28 $c0 00
         $m0 1 $/0 03 $c0 00
         $cl
         $p0 07 
         $c0 01
         #NIGHT_SHOT_SPEED
         $cl
         #EM_SHOT_SPEED
         $cx
         $-0 r1 
         #CMD(04,$w0)
         $cx $cx $cx $cx;

CC_SET= $z0 $c0 08 06 02 00 01 $p0 07 $c0 00 
                 #FILTER_NORMAL 
                 $cl 
                 #FILTER_NIGHT $cx 5B #END $cx; 

CC_UNSET=06 02 00 01 00 5B #END;

TAKE= #E_E_F
              $c6 01
              $cx
              $z0 $-0 re
              $c0 00 
              $cl
              $p0 0d $c0 01 
              #WB_LED
              !1 $cx !0
              06 02 00 01 01 $ze
              $ce 09 33 $cl 32 $cx $f
              #W_F_M_T
              #W_F_C_S
              $cx $t0020 $cx;
 
LOCK_AE=  $p0 0d $c0 00 $p0 0e $c0 00 
                      #CMD(01,01) $cx $cx;

UNLOCK_AE= #CMD(01,00);

EXPOSURE= $s0 09 #TAKE_EXPOSURE #CMD(06,$w0);

INIT_SAT=#SATURATION #CMD(58,$w1);

INIT= #CMD(54,#BRIGHTNESS)
           #CMD(55,#CONTRAST)
           #EXPOSURE  $s6 a9 $sb 00; 


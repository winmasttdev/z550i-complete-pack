                   #RESET_WB 
      $s0 0a #SET_CONTRAST
      $s0 0a #SET_BRIGHTNESS 
                  #CMD(43,00)
                  $b6 09 0 4
     $s0 0a #SET_EXPOSURE
     $s0 0a #SET_CC_YELLOW
     $s0 0a #SET_CC_MAGENTA
     $s0 %0 
     $c0 0b
  // Low Light
     $s0 15 #SET_EXPOSURE

     $cl 
     $c0 0c
 // Cloudy Outdoors
     #CMD(11,00)
     $s0 12 #SET_CC_YELLOW
     $s0 0c #SET_CC_MAGENTA
     $cl
     $c0 0d
  // document
     $s0 0d #SET_CONTRAST
     $s0 15 #SET_EXPOSURE
     $cx $cx;


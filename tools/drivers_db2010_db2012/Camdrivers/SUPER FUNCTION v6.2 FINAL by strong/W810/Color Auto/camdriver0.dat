// YOU CAN EDIT BELOW VALUES TO SELECT YOUR OWN DESIRED FINAL EFFECT
// DON'T TOUCH $s2, $-0, $s0

     // REMEMBER: ALL VALUES ARE IN HEXADECIMAL NUMBER SYSTEM!
 //------------------------------------------------------------------------------------------------------------//

            //EDITING FUNCTIONS by USER

SHARPNESS= 05;

SATURATION= $s1 03;

EM_SHOT_SPEED=  $s0 40;   // use  $s0 3f;  for faster shot

NIGHT_SHOT_SPEED=  $s0 3d;

LED_SPEED=  $s0 3f;   // only for shot LED ON

CONTRAST= 00;
BRIGHTNESS= 00;

MACRO_ZOOM= 10;   // 10=x4 - 20=x2 - 08=x8

TAKE_EXPOSURE= $-0 09;

FILTER_NORMAL= 01;   // disabled
FILTER_NIGHT= 00;  // enabled

JPEG_COMPRESS= $s2 5F;

ZOOM_4x=$s0 0a $<0 6 $s1 %0 $>1 1 $+0 r1 $/0 %0; 
ZOOM_6x=$s0 03 $<0 8 $+0 34 $s1 %0 $*1 12 $-0 r1 $/0 0a;
ZOOM_8x=$s0 09 $<0 8 $+0 B0 $s1 %0 $*1 38 $-0 r1 $/0 1e;
ZOOM_12x=$s0 09 $<0 8 $+0 ce $s1 %0 $*1 3b $-0 r1 $/0 1e;
ZOOM_16x=$s0 2a $-0 %0 $*0 02 $+0 80;

ZOOM= #ZOOM_6x;     // For change zoom use: #ZOOM_4x; (for 4x zoom) - #ZOOM_8x; (for 8x zoom) etcetera.


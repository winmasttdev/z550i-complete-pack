  #CMD(52,$w0);

JMAX=06 02 00 0D !1 !0 #END;
JMIN=06 02 00 0F !1 !0 #END;
JAVG=06 02 00 11 !1 !0 #END;

JQ=$p1 0e $c1 01
   $s2 50
   #MIN(00,01)
   $cl
   $p1 07 $c1 01
   $c6 01
   #MIN(00,01)
   $cx $cx $cx
   $m1 2 $-1 02
   07 02 00 13 $w2 $w1 4B #END;

JPEG=$z0 $p1 05
     $c0 02 #JMIN(01,2c) #JMAX(00,1E) #JAVG(00,0f) $cl
     $c0 04 #JMIN(01,2c) #JMAX(00,C8) #JAVG(00,64) $cl
     $c0 08 #JMIN(01,2c) #JMAX(03,84) #JAVG(02,58)
     $cx $cx $cx #JPEG_COMPRESS #JQ;


seq_set_prop_5_0=#JPEG
		 #CMD(21,00)
		 $s6 00;

seq_set_prop_5_1=#JPEG
		 #CMD(21,01)
		 $s6 01;


[Version]
Signature="$WINDOWS NT$"
Provider=%SEMCName%
Class=USB
ClassGUID={36fc9e60-c465-11cf-8056-444553540000} 
DriverVer=07/10/2007,2.0.0.1
CatalogFile=ggsemc.cat

[DestinationDirs]
GGSEMC_CopyFiles = 12
WDFCoInstaller_CopyFiles = 11

[SourceDisksNames.x86]
1 = %InstallationDiskName%,,,\x86

[SourceDisksNames.Amd64]
1 = %InstallationDiskName%,,,\AMD64

[SourceDisksFiles]
ggsemc.sys = 1
wdfcoinstaller01005.dll = 1

[Manufacturer]
%MfgName%=SEMC,NTx86,NTAmd64

; W2K
[SEMC]
%DeviceDesc.Flash%=GGSEMC_Install, USB\VID_0FCE&PID_ADDE
%DeviceDesc.HCB-100%=GGSEMC_Install, USB\VID_0FCE&PID_D064
%DeviceDesc.HCB-120%=GGSEMC_Install, USB\VID_0FCE&PID_D083
%DeviceDesc.HCB-100E%=GGSEMC_Install, USB\VID_0FCE&PID_D0A8
%DeviceDesc.DFU%=GGSEMC_Install, USB\VID_0FCE&PID_FFFF
%DeviceDesc.GEN%=GGSEMC_Install, USB\VID_0BDB&PID_100E

[SEMC.NTx86]
%DeviceDesc.Flash%=GGSEMC_Install, USB\VID_0FCE&PID_ADDE
%DeviceDesc.HCB-100%=GGSEMC_Install, USB\VID_0FCE&PID_D064
%DeviceDesc.HCB-120%=GGSEMC_Install, USB\VID_0FCE&PID_D083
%DeviceDesc.HCB-100E%=GGSEMC_Install, USB\VID_0FCE&PID_D0A8
%DeviceDesc.DFU%=GGSEMC_Install, USB\VID_0FCE&PID_FFFF
%DeviceDesc.GEN%=GGSEMC_Install, USB\VID_0BDB&PID_100E

[SEMC.NTAmd64]
%DeviceDesc.Flash%=GGSEMC_Install, USB\VID_0FCE&PID_ADDE
%DeviceDesc.HCB-100%=GGSEMC_Install, USB\VID_0FCE&PID_D064
%DeviceDesc.HCB-120%=GGSEMC_Install, USB\VID_0FCE&PID_D083
%DeviceDesc.HCB-100E%=GGSEMC_Install, USB\VID_0FCE&PID_D0A8
%DeviceDesc.DFU%=GGSEMC_Install, USB\VID_0FCE&PID_FFFF
%DeviceDesc.GEN%=GGSEMC_Install, USB\VID_0BDB&PID_100E

[GGSEMC_Install.NT]
CopyFiles=GGSEMC_CopyFiles

[GGSEMC_Install.NT.Services]
Addservice = ggsemc, 0x00000002, GGSEMC_Install.Service

[GGSEMC_Install.Service]
DisplayName=%SvcDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\ggsemc.sys
AddReg=GGSEMC_Install.Service_AddReg

[GGSEMC_Install.Service_AddReg]
HKR, "Parameters", "NextUSBPortId", 0x00010003, 1
HKR, "Parameters\SLNames","VID_0FCE&PID_ADDE", 0x00000000, "EPIUSB"
HKR, "Parameters\SLNames","VID_0BDB&PID_100E", 0x00000000, "EPIUSB"
HKR, "Parameters\SLNames","VID_0FCE&PID_FFFF", 0x00000000, "SEMCDFU"
HKR, "Parameters\SLNames","VID_0FCE&PID_D064", 0x00000000, "HCB100"
HKR, "Parameters\SLNames","VID_0FCE&PID_D083", 0x00000000, "HCB120"
HKR, "Parameters\SLNames","VID_0FCE&PID_D0A8", 0x00000000, "HCB100E"


[GGSEMC_CopyFiles]
ggsemc.sys

[GGSEMC_Install.NT.CoInstallers]
AddReg=WDFCoInstaller_AddReg
CopyFiles=WDFCoInstaller_CopyFiles

[WDFCoInstaller_CopyFiles]
wdfcoinstaller01005.dll

[WDFCoInstaller_AddReg]
HKR,,CoInstallers32,0x00010000,"wdfcoinstaller01005.dll,WdfCoInstaller"

[GGSEMC_Install.NT.Wdf]
KmdfService=GGSEMC,GGSEMC_WDFSection

[GGSEMC_WDFSection]
KmdfLibraryVersion = 1.5

[Strings]
SEMCName="Sony Ericsson Mobile Communications"
MfgName="Sony Ericsson Mobile Communications"
DeviceDesc.Flash="SEMC Flash Device"
DeviceDesc.HCB-100="SEMC HCB-100 Device"
DeviceDesc.HCB-120="SEMC HCB-120 Device"
DeviceDesc.HCB-100E="SEMC HCB-100E Device"
DeviceDesc.DFU="SEMC DFU Device"
DeviceDesc.GEN="Generic Flash Device"
SvcDesc="SEMC USB Flash Driver"
InstallationDiskName="SEMC Flash Installation"